    <worksheet name='13_Data_Quality_Coverage'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontcolor='#000000' fontname='Benton Sans Book'>Data Quality &amp; Coverage by Year (2023–2025)</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='GB_Electricity_Demand_Tableau' name='federated.105qbgy0u6fvoz1f01g780d50o2a' />
          </datasources>
          <datasource-dependencies datasource='federated.105qbgy0u6fvoz1f01g780d50o2a'>
            <column caption='Coverage Rate' datatype='real' default-format='p0.0%' name='[Calculation_3330610707423238]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([SourceRecordPresent]) / COUNT([IntervalID])' />
            </column>
            <column caption='Quality Summary' datatype='string' name='[Calculation_3330610709045255]' role='measure' type='nominal'>
              <calculation class='tableau' formula='&quot;Coverage: &quot; + STR(ROUND([Calculation_3330610707423238] * 100, 1)) + &quot;%&quot;&#10;+ CHAR(10) + &quot;Observed / expected intervals: &quot;&#10;+ STR(SUM([SourceRecordPresent])) + &quot; / &quot; + STR(COUNT([IntervalID]))&#10;+ CHAR(10) + &quot;Missing intervals: &quot; + STR(SUM([MissingPeriodFlag]))&#10;+ CHAR(10) + &quot;Missing demand values: &quot; + STR(SUM([MissingActualFlag]))&#10;+ CHAR(10) + &quot;Duplicates removed: &quot;&#10;+ STR(SUM(IF [DayAuditAnchor] = 1 THEN [DuplicateRowsRemovedDay] ELSE 0 END))' />
            </column>
            <column caption='Day Audit Anchor' datatype='integer' name='[DayAuditAnchor]' role='dimension' type='quantitative' />
            <column caption='Duplicate Rows Removed Day' datatype='integer' name='[DuplicateRowsRemovedDay]' role='dimension' type='quantitative' />
            <column caption='Interval ID' datatype='datetime' name='[IntervalID]' role='dimension' type='ordinal' />
            <column caption='Missing Actual Flag' datatype='integer' name='[MissingActualFlag]' role='measure' type='quantitative' />
            <column caption='Missing Period Flag' datatype='integer' name='[MissingPeriodFlag]' role='measure' type='quantitative' />
            <column caption='Source Record Present' datatype='integer' name='[SourceRecordPresent]' role='measure' type='quantitative' />
            <column datatype='integer' name='[Year]' role='dimension' type='quantitative' />
            <column-instance column='[Year]' derivation='None' name='[none:Year:ok]' pivot='key' type='ordinal' />
            <column-instance column='[Calculation_3330610709045255]' derivation='User' name='[usr:Calculation_3330610709045255:nk]' pivot='key' type='nominal' />
          </datasource-dependencies>
          <aggregation value='true' />
        </view>
        <style>
          <style-rule element='cell'>
            <format attr='width' value='282' />
            <format attr='height' field='[federated.105qbgy0u6fvoz1f01g780d50o2a].[none:Year:ok]' value='148' />
          </style-rule>
        </style>
        <panes>
          <pane selection-relaxation-option='selection-relaxation-allow'>
            <view>
              <breakdown value='auto' />
            </view>
            <mark class='Text' />
            <encodings>
              <text column='[federated.105qbgy0u6fvoz1f01g780d50o2a].[usr:Calculation_3330610709045255:nk]' />
            </encodings>
            <style>
              <style-rule element='mark'>
                <format attr='mark-labels-cull' value='true' />
                <format attr='mark-labels-show' value='true' />
