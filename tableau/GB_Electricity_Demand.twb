    <worksheet name='12_Forecast_Bias_By_Time'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontcolor='#000000' fontname='Benton Sans Book'>Average Forecast Bias by Time of Day (2025 Test Set)</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='GB_Electricity_Demand_Tableau' name='federated.105qbgy0u6fvoz1f01g780d50o2a' />
          </datasources>
          <datasource-dependencies datasource='federated.105qbgy0u6fvoz1f01g780d50o2a'>
            <column caption='Evaluation Split' datatype='string' name='[EvaluationSplit]' role='dimension' type='nominal' />
            <column datatype='real' name='[HourOfDay]' role='dimension' type='ordinal' />
            <column caption='Selected Error MW' datatype='real' name='[SelectedErrorMW]' role='measure' type='quantitative' />
            <column-instance column='[SelectedErrorMW]' derivation='Avg' name='[avg:SelectedErrorMW:qk]' pivot='key' type='quantitative' />
            <column-instance column='[EvaluationSplit]' derivation='None' name='[none:EvaluationSplit:nk]' pivot='key' type='nominal' />
            <column-instance column='[HourOfDay]' derivation='None' name='[none:HourOfDay:qk]' pivot='key' type='quantitative' />
          </datasource-dependencies>
          <filter class='categorical' column='[federated.105qbgy0u6fvoz1f01g780d50o2a].[none:EvaluationSplit:nk]'>
            <groupfilter function='member' level='[none:EvaluationSplit:nk]' member='&quot;Test&quot;' user:ui-domain='database' user:ui-enumeration='inclusive' user:ui-marker='enumerate' />
          </filter>
          <slices>
            <column>[federated.105qbgy0u6fvoz1f01g780d50o2a].[none:EvaluationSplit:nk]</column>
          </slices>
          <aggregation value='true' />
        </view>
        <style>
          <style-rule element='refline'>
            <format attr='fill-above' id='refline0' value='#00000000' />
            <format attr='fill-below' id='refline0' value='#00000000' />
          </style-rule>
        </style>
        <panes>
          <pane selection-relaxation-option='selection-relaxation-allow'>
            <view>
              <breakdown value='auto' />
            </view>
            <mark class='Line' />
            <reference-line axis-column='[federated.105qbgy0u6fvoz1f01g780d50o2a].[none:HourOfDay:qk]' enable-instant-analytics='true' formula='constant' id='refline0' label-type='automatic' scope='per-table' value='0.0' value-column='[federated.105qbgy0u6fvoz1f01g780d50o2a].[none:HourOfDay:qk]' z-order='1' />
            <reference-line axis-column='[federated.105qbgy0u6fvoz1f01g780d50o2a].[avg:SelectedErrorMW:qk]' enable-instant-analytics='true' formula='average' id='refline1' label-type='automatic' probability='95' scope='per-table' value-column='[federated.105qbgy0u6fvoz1f01g780d50o2a].[avg:SelectedErrorMW:qk]' z-order='2' />
          </pane>
        </panes>
        <rows>[federated.105qbgy0u6fvoz1f01g780d50o2a].[avg:SelectedErrorMW:qk]</rows>
