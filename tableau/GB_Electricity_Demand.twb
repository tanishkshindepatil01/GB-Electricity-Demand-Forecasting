      <column caption='Baseline Abs Error MW' datatype='real' name='[BaselineAbsErrorMW]' role='measure' type='quantitative' />
      <column caption='Baseline Alignment Rule' datatype='string' name='[BaselineAlignmentRule]' role='dimension' type='nominal' />
      <column caption='Baseline Error MW' datatype='string' name='[BaselineErrorMW]' role='dimension' type='nominal' />
      <column caption='Baseline Forecast MW' datatype='string' name='[BaselineForecastMW]' role='dimension' type='nominal' />
      <column caption='Boosting Abs Error MW' datatype='real' name='[BoostingAbsErrorMW]' role='measure' type='quantitative' />
      <column caption='Boosting Error MW' datatype='string' name='[BoostingErrorMW]' role='dimension' type='nominal' />
      <column caption='Boosting Forecast MW' datatype='string' name='[BoostingForecastMW]' role='dimension' type='nominal' />
      <column caption='Baseline RMSE MW' datatype='real' name='[Calculation_3330610677350400]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SQRT(AVG([BaselineSquaredErrorMW2]))' />
      </column>
      <column caption='Ridge RMSE MW' datatype='real' name='[Calculation_3330610677403649]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SQRT(AVG([RidgeSquaredErrorMW2]))' />
      </column>
      <column caption='Boosting RMSE MW' datatype='real' name='[Calculation_3330610677440514]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SQRT(AVG([BoostingSquaredErrorMW2]))' />
      </column>
      <column caption='Top 10 Errors' datatype='boolean' name='[Calculation_3330610702540803]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[SelectedDeviationRank] &lt;= 10' />
      </column>
      <column caption='Interval (local)' datatype='string' name='[Calculation_3330610703683588]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='REPLACE(LEFT([LocalStartISO], 16), &quot;T&quot;, &quot; &quot;)' />
      </column>
      <column caption='Coverage Rate' datatype='real' default-format='p0.0%' name='[Calculation_3330610707423238]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([SourceRecordPresent]) / COUNT([IntervalID])' />
      </column>
      <column caption='Quality Summary' datatype='string' name='[Calculation_3330610709045255]' role='measure' type='nominal'>
        <calculation class='tableau' formula='&quot;Coverage: &quot; + STR(ROUND([Calculation_3330610707423238] * 100, 1)) + &quot;%&quot;&#10;+ CHAR(10) + &quot;Observed / expected intervals: &quot;&#10;+ STR(SUM([SourceRecordPresent])) + &quot; / &quot; + STR(COUNT([IntervalID]))&#10;+ CHAR(10) + &quot;Missing intervals: &quot; + STR(SUM([MissingPeriodFlag]))&#10;+ CHAR(10) + &quot;Missing demand values: &quot; + STR(SUM([MissingActualFlag]))&#10;+ CHAR(10) + &quot;Duplicates removed: &quot;&#10;+ STR(SUM(IF [DayAuditAnchor] = 1 THEN [DuplicateRowsRemovedDay] ELSE 0 END))' />
      </column>
